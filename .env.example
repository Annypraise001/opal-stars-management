PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-before-deployment
DATABASE_PATH=./data/opal.sqlite
PAYMENT_PROOF_DIRECTORY=./data/payment-proofs

# Set only with your actual payment setup. Empty values keep payments disabled.
BOOKING_SERVICE_FEE_PERCENT=
BITCOIN_ADDRESS=
ETHEREUM_ADDRESS=
LITECOIN_ADDRESS=
USDT_ADDRESS=
BUSD_ADDRESS=

# Required bank fields: bank name, account name, account number, routing number, SWIFT/BIC, reference instructions.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ROUTING_OR_SORT_CODE=
BANK_BRANCH_CODE=
BANK_SWIFT_BIC=
BANK_ADDRESS=
BANK_IBAN=
BANK_REFERENCE_INSTRUCTIONS=